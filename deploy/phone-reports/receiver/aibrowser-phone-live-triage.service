[Unit]
Description=Bounded advisory triage of sanitized live phone progress
After=network-online.target aibrowser-phone-receiver.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=aibrowserupload
StateDirectory=aibrowser-phone-live-triage
StateDirectoryMode=0750
WorkingDirectory=/var/lib/aibrowser-phone-live-triage
ExecStart=/usr/bin/python3 /opt/aibrowser-phone-receiver/triage_codex.py --live /var/lib/aibrowser-phone-receiver/live --state /var/lib/aibrowser-phone-live-triage
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/aibrowser-phone-live-triage /root/.codex
ReadOnlyPaths=/var/lib/aibrowser-phone-receiver/live
InaccessiblePaths=-/root/.ssh -/root/.aws -/root/projects -/signing
RestrictSUIDSGID=true
UMask=0077
MemoryMax=768M
CPUQuota=100%
Nice=10
StandardOutput=null
StandardError=null
